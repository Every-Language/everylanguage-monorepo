# ============================================================
# PRODUCTION ENVIRONMENT SECRETS
# ============================================================

ENV=production

# Supabase
# Note: SUPABASE_URL can be derived from SUPABASE_PROJECT_ID if not set
# Format: https://{PROJECT_ID}.supabase.co
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_DB_PASSWORD=
# Note: SUPABASE_ANON_KEY is preferred, SUPABASE_PUBLISHABLE_KEY is fallback
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# PowerSync (App Bible)
POWERSYNC_URL=
POWERSYNC_INSTANCE_ID=

# Stripe
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2 Production Bucket
R2_BUCKET_NAME=

# PowerSync - Instance IDs for Production
POWERSYNC_BIBLE_INSTANCE_ID=your_bible_prod_instance_id_here
POWERSYNC_RECORD_INSTANCE_ID=your_record_prod_instance_id_here

# ============================================================
# DERIVED VARIABLES (automatically generated by deployment scripts)
# ============================================================
# The following variables are automatically derived from the base variables above:
# - VITE_SUPABASE_URL (from SUPABASE_URL or SUPABASE_PROJECT_ID)
# - VITE_SUPABASE_ANON_KEY (from SUPABASE_ANON_KEY or SUPABASE_PUBLISHABLE_KEY)
# - NEXT_PUBLIC_SUPABASE_URL (from SUPABASE_URL or SUPABASE_PROJECT_ID)
# - NEXT_PUBLIC_SUPABASE_ANON_KEY (from SUPABASE_ANON_KEY or SUPABASE_PUBLISHABLE_KEY)
# - EXPO_PUBLIC_SUPABASE_URL (from SUPABASE_URL or SUPABASE_PROJECT_ID)
# - EXPO_PUBLIC_SUPABASE_ANON_KEY (from SUPABASE_ANON_KEY or SUPABASE_PUBLISHABLE_KEY)
# - EXPO_PUBLIC_POWERSYNC_URL (from POWERSYNC_URL)
# You don't need to set these manually - they're created during deployment.