# =================================
# ENVIRONMENT CONFIGURATION
# =================================
# These variables are set differently per environment:
# - Development: Points to dev Supabase/PowerSync instances
# - Production: Points to prod Supabase/PowerSync instances
#
# In CI/CD, GitHub Actions environments set these values automatically.
# For local development, set these to your dev environment values.

# Environment indicator (development or production)
EXPO_PUBLIC_ENVIRONMENT=development

# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_dev_anon_key_here

# PowerSync Configuration
EXPO_PUBLIC_POWERSYNC_URL=https://your-dev-instance.powersync.journeyapps.com