{
  "name": "app-record",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "npx expo prebuild",
    "prebuild:clean": "npx expo prebuild --clean",
    "build:dev": "eas build --local --profile development",
    "build:dev:ios": "eas build --local --profile development --platform ios",
    "build:dev:android": "eas build --local --profile development --platform android",
    "build:prod": "eas build --local --profile production",
    "build:prod:ios": "eas build --local --profile production --platform ios",
    "build:prod:android": "eas build --local --profile production --platform android",
    "update:dev": "eas update --branch development",
    "update:prod": "eas update --branch production",
    "doctor": "npx expo-doctor",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "lint:all": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:run": "jest --watchAll=false --coverage=false",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "powersync:generate-schema": "node scripts/generate-powersync-schema.cjs",
    "powersync:verify-schema": "node scripts/verify-powersync-schema.cjs"
  },
  "dependencies": {
    "@everylanguage/shared-types": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@supabase/supabase-js": "^2.47.10",
    "expo": "53.0.23",
    "expo-status-bar": "~2.2.3",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@eslint/js": "^9.30.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@testing-library/react-native": "^12.8.1",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~13.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.10",
    "prettier": "^3.5.3",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "jest-expo",
    "coverageProvider": "v8",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/coverage/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/index.ts",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageDirectory": "coverage",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@/app/(.*)$": "<rootDir>/src/app/$1",
      "^@/features/(.*)$": "<rootDir>/src/features/$1",
      "^@/shared/(.*)$": "<rootDir>/src/shared/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(?:\\.pnpm/)?(@react-native|react-native|jest-react-native|@react-native-community|@react-native/js-polyfills|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|isows|@supabase))"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.cjs"
    ]
  },
  "private": true
}
