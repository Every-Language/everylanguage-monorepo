{
  "name": "el-record",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:clean": "expo prebuild --platform ios --clean && expo run:ios",
    "web": "expo start --web",
    "prebuild": "npx expo prebuild",
    "prebuild:clean": "npx expo prebuild --clean",
    "start:mem": "NODE_OPTIONS=--max-old-space-size=8192 expo start -c",
    "android:mem": "NODE_OPTIONS=--max-old-space-size=8192 expo run:android",
    "ios:mem": "NODE_OPTIONS=--max-old-space-size=8192 expo run:ios",
    "clean:metro": "rm -rf $TMPDIR/metro-* $TMPDIR/react-* node_modules/.cache/metro .expo",
    "build:dev": "eas build --local --profile development",
    "build:dev:ios": "eas build --local --profile development --platform ios",
    "build:dev:android": "eas build --local --profile development --platform android",
    "build:preview": "eas build --local --profile preview",
    "build:preview:ios": "eas build --local --profile preview --platform ios",
    "build:preview:android": "eas build --local --profile preview --platform android",
    "build:prod": "eas build --local --profile production",
    "build:prod:ios": "eas build --local --profile production --platform ios",
    "build:prod:android": "eas build --local --profile production --platform android",
    "build:dev:script": "./scripts/build-dev.sh",
    "update:dev": "eas update --branch development",
    "update:preview": "eas update --branch preview",
    "update:prod": "eas update --branch production",
    "doctor": "npx expo-doctor",
    "verify": "./scripts/verify-managed-workflow.sh",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "lint:all": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:run": "jest --watchAll=false --coverage=false",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "prepare": "husky",
    "powersync:generate-schema": "node scripts/generate-powersync-schema.cjs",
    "powersync:combine-schema": "node scripts/combine-powersync-schema.cjs",
    "powersync:build-schema": "npm run powersync:generate-schema && npm run powersync:combine-schema",
    "powersync:verify-schema": "node scripts/verify-powersync-schema.cjs"
  },
  "private": true,
  "dependencies": {
    "@everylanguage/shared-types": "^1.0.11",
    "@expo/vector-icons": "^14.1.0",
    "@gorhom/bottom-sheet": "^5.1.6",
    "@hookform/resolvers": "^5.2.2",
    "@op-engineering/op-sqlite": "^14.1.4",
    "@powersync/op-sqlite": "^0.7.5",
    "@powersync/react": "^1.6.0",
    "@powersync/react-native": "^1.23.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-menu/menu": "1.2.4",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.25",
    "@react-navigation/stack": "^7.3.6",
    "@shopify/flash-list": "1.7.6",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-query": "^5.80.10",
    "core-js": "^3.44.0",
    "eventemitter3": "^5.0.1",
    "expo": "53.0.23",
    "expo-asset": "~11.1.7",
    "expo-audio": "~0.4.9",
    "expo-background-fetch": "^13.1.6",
    "expo-background-task": "~0.2.8",
    "expo-blur": "^14.1.5",
    "expo-build-properties": "~0.14.8",
    "expo-clipboard": "~7.1.5",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.2.4",
    "expo-device": "~7.1.4",
    "expo-document-picker": "~13.1.6",
    "expo-file-system": "~18.1.10",
    "expo-font": "~13.3.1",
    "expo-linear-gradient": "^14.1.5",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-location": "~18.1.6",
    "expo-navigation-bar": "~4.2.8",
    "expo-notifications": "~0.31.4",
    "expo-sharing": "~13.1.5",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.11",
    "expo-task-manager": "~13.1.6",
    "expo-updates": "~0.28.17",
    "i18next": "^25.2.1",
    "libphonenumber-js": "^1.12.24",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.63.0",
    "react-i18next": "^15.5.3",
    "react-native": "0.79.6",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-localize": "^3.5.4",
    "react-native-phone-entry": "^0.2.4",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-track-player": "^4.1.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-uuid": "^2.0.3",
    "react-native-web": "^0.20.0",
    "react-native-zip-archive": "^7.0.1",
    "zod": "^4.1.11",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@eslint/js": "^9.30.1",
    "@redux-devtools/extension": "^3.3.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~13.0.0",
    "better-sqlite3": "^11.8.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "expo-build-properties": "~0.14.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.10",
    "lint-staged": "^16.1.2",
    "powersync": "^0.7.1",
    "prettier": "^3.5.3",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "powersync/AppSchema.ts": []
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-zip-archive",
          "react-native-track-player"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/coverage/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/index.ts",
      "!src/**/*.test.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageDirectory": "coverage",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@/app/(.*)$": "<rootDir>/src/app/$1",
      "^@/features/(.*)$": "<rootDir>/src/features/$1",
      "^@/shared/(.*)$": "<rootDir>/src/shared/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|isows|@supabase|@powersync)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.cjs"
    ]
  },
  "packageManager": "npm@11.5.2"
}
