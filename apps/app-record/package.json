{
  "name": "el-record",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "npx expo prebuild",
    "lint": "eslint src/ --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "powersync:generate-schema": "node scripts/generate-powersync-schema.cjs",
    "powersync:combine-schema": "node scripts/combine-powersync-schema.cjs",
    "powersync:build-schema": "npm run powersync:generate-schema && npm run powersync:combine-schema",
    "powersync:verify-schema": "node scripts/verify-powersync-schema.cjs"
  },
  "private": true,
  "dependencies": {
    "@everylanguage/shared-types": "^1.0.11",
    "@expo/vector-icons": "^14.1.0",
    "@op-engineering/op-sqlite": "^14.1.4",
    "@powersync/op-sqlite": "^0.7.5",
    "@powersync/react": "^1.6.0",
    "@powersync/react-native": "^1.23.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-menu/menu": "1.2.4",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "@supabase/supabase-js": "^2.50.0",
    "expo": "53.0.23",
    "expo-asset": "~11.1.7",
    "expo-blur": "^14.1.5",
    "expo-constants": "~17.1.7",
    "expo-dev-client": "~5.2.4",
    "expo-file-system": "~18.1.10",
    "expo-linking": "~7.1.7",
    "expo-localization": "~16.1.6",
    "expo-router": "^5.0.7",
    "expo-splash-screen": "^31.0.13",
    "i18next": "^25.7.1",
    "react": "19.0.0",
    "react-i18next": "^15.7.4",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-url-polyfill": "^2.0.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@eslint/js": "^9.30.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/react": "~19.0.10",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~13.0.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~53.0.10",
    "postinstall-postinstall": "^2.1.0",
    "powersync": "^0.7.1",
    "prettier": "^3.5.3",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ],
    "powersync/AppSchema.ts": [],
    "powersync/AppSchema.generated.ts": []
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/coverage/"
    ],
    "moduleNameMapper": {
      "^@/powersync/(.*)$": "<rootDir>/powersync/$1",
      "^@/features/(.*)$": "<rootDir>/src/features/$1",
      "^@/shared/(.*)$": "<rootDir>/src/shared/$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|isows|@supabase|@powersync)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.cjs"
    ]
  }
}
